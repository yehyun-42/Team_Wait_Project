FLASK_APP=apps.app:create_app("local")
FLASK_ENV=development

FLASK_DEBUG=1

MAIL_SERVER=smtp.naver.com
MAIL_PORT=465
MAIL_USE_SSL=True
MAIL_USERNAME=YOUR_MAIL_ADDRESS
MAIL_PASSWORD=YOUR_MAIL_PASSWORD

DISCORD_WEBHOOK_URL=YOUR_WEBHOOK_URL

FLASK_RUN_HOST=0.0.0.0
FLASK_RUN_PORT=5000
FLASK_RUN_EXTRA_ARGS=--with-threads
